find_closest <- function(i){
temp <- df1[i,]
temp_2 <- subset(df2, cheat == temp$cheat)
temp_2$third_col_one <- temp$third_col
temp_2$diff <- abs(temp_2$third_col_one - temp_2$third_col)
temp_2 <- subset(temp_2, diff == min(temp_2$diff))
return(data.frame(df_1_row = i, df_2_row = temp_2$row))
}
lapply(1:nrow(df1), find_closest)
do.call(rbind(lapply(1:nrow(df1), find_closest)))
do.call(rbind, lapply(1:nrow(df1), find_closest)
)
