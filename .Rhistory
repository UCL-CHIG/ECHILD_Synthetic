glm_estimator <- glm(pikachu ~ year, data = non_missing)
preds <- predict(glm_estimator, newdata = data.frame(year = non_missing$year), type = "link", se.fit = TRUE)
critval <- 1.96 ## approx 95% CI
upr <- preds$fit + (critval * preds$se.fit)
lwr <- preds$fit - (critval * preds$se.fit)
fit <- preds$fit
non_missing$predicted <- fit
non_missing$predicted_lower <- lwr
non_missing$predicted_upper <- upr
non_missing$problem <- ifelse(non_missing$pikachu < non_missing$predicted_lower
| non_missing$pikachu > non_missing$predicted_upper,1,0)
