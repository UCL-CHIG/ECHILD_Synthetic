missing$predicted <- ifelse(missing$predicted < 0, NA, missing$predicted)
missing$predicted_lower <- ifelse(missing$predicted_lower < 0, NA, missing$predicted_lower)
missing$predicted_upper <- ifelse(missing$predicted_upper < 0, NA, missing$predicted_upper)
output <- rbind(output, missing)
}
}
if(nrow(non_missing) > 0){
