if(nrow(missing) > 0){
colnames(missing) <- c("year","value")
missing_predicted <- predict(glm_estimator, newdata = data.frame(year = missing$year), type = "link", se.fit = TRUE)
upr <- missing_predicted$fit + (critval * missing_predicted$se.fit)
lwr <- missing_predicted$fit - (critval * missing_predicted$se.fit)
fit <- missing_predicted$fit
missing$predicted <- fit
